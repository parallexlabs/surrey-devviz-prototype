{
  "name": "surrey-devviz-demo",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/parallexlabs/surrey-devviz-prototype.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:site": "VITE_BASE=/demos/surrey/ VITE_NOINDEX=1 VITE_OUT_DIR=dist-site vite build",
    "preview": "vite preview",
    "fetch-data": "python3 scripts/fetch_data.py",
    "test": "vitest run && python3 -m unittest discover -s tests -p 'fetch_data_test.py'",
    "test:e2e": "playwright test",
    "test:axe": "node scripts/axe-scan.mjs",
    "record": "node scripts/record-walkthrough.mjs",
    "serve:dist": "vite preview --port 4173",
    "serve:site": "node scripts/serve-site.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "maplibre-gl": "^6.13.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "1.63.0",
    "jsdom": "^30.1.1",
    "pngjs": "^7.0.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
